<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/successScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="34dp"
        android:paddingBottom="28dp">

        <!-- Fake status / time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:00"
            android:textColor="#111111"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Check circle -->
        <TextView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_success_circle"
            android:gravity="center"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ești treaz."
            android:textColor="#111111"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginTop="20dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="provocarea completă.\nbună dimineața."
            android:textColor="#A8A8A8"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EFEFEF"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="18dp" />

        <!-- Achievement rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/AchievementIcon"
                    android:text="🏋" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/AchievementTitle"
                        android:text="flotări ținute" />

                    <TextView
                        style="@style/AchievementSub"
                        android:text="fără întrerupere" />

                </LinearLayout>

                <TextView
                    style="@style/AchievementValue"
                    android:text="15 sec" />

            </LinearLayout>

            <View style="@style/AchievementDivider" />

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/AchievementIcon"
                    android:text="◷" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/AchievementTitle"
                        android:text="ora alarmei" />

                    <TextView
                        style="@style/AchievementSub"
                        android:text="joi, 21 mai" />

                </LinearLayout>

                <TextView
                    style="@style/AchievementValue"
                    android:text="07:00" />

            </LinearLayout>

            <View style="@style/AchievementDivider" />

            <!-- Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/AchievementIcon"
                    android:text="♨" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/AchievementTitle"
                        android:text="streak" />

                    <TextView
                        style="@style/AchievementSub"
                        android:text="zile consecutive" />

                </LinearLayout>

                <TextView
                    style="@style/AchievementValueGreen"
                    android:text="6 zile" />

            </LinearLayout>

            <View style="@style/AchievementDivider" />

            <!-- Row 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/AchievementIcon"
                    android:text="🏆" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/AchievementTitle"
                        android:text="record\npersonal"
                        android:lineSpacingExtra="-2dp" />

                    <TextView
                        style="@style/AchievementSub"
                        android:text="cel mai bun până acum" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/AchievementValue"
                        android:text="15 sec" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="nou"
                        android:textColor="#6B8E23"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_new_badge"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Back button only -->
        <TextView
            android:id="@+id/finishButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="⌂  înapoi la alarme"
            android:textColor="#888888"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_outline_button" />

    </LinearLayout>

</ScrollView>