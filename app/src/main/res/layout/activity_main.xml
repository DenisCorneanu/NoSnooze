<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="26dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="data"
            android:textColor="#B7B7B7"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mainClockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.055"
            android:text="07:30"
            android:textColor="#111111"
            android:textSize="62sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="status"
                android:textColor="#A8A8A8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/nextAlarmPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_small_pill"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:text="activă"
                android:textColor="#8A8A8A"
                android:textSize="10sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="#EFEFEF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.06"
                android:text="alarme"
                android:textColor="#B9B9B9"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addAlarmButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_add_circle"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

        </LinearLayout>

        <ScrollView
            android:id="@+id/alarmListScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/alarmListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

        <LinearLayout
            android:id="@+id/challengeCard"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_challenge_black"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_challenge_icon"
                android:gravity="center"
                android:text="🏋"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="oprire prin&#10;flotări"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="15 secunde ·&#10;cameră față"
                    android:textColor="#999999"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#555555"
                android:textSize="24sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/StatCard">

                <TextView
                    style="@style/StatNumber"
                    android:text="14" />

                <TextView
                    style="@style/StatLabel"
                    android:text="alarme&#10;oprite" />

            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/StatCard">

                <TextView
                    style="@style/StatNumber"
                    android:lineSpacingExtra="-4dp"
                    android:text="5&#10;zile" />

                <TextView
                    style="@style/StatLabel"
                    android:text="la&#10;rând" />

            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/StatCard">

                <TextView
                    style="@style/StatNumber"
                    android:text="100%" />

                <TextView
                    style="@style/StatLabel"
                    android:text="săptămâna&#10;asta" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-18dp"
            android:background="@drawable/bg_bottom_circle"
            android:gravity="center"
            android:text="↓"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

    </LinearLayout>

</ScrollView>