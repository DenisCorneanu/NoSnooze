<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:paddingTop="26dp"
        android:paddingBottom="18dp">

        <!-- Date -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="joi, 21 mai"
            android:textColor="#B7B7B7"
            android:textSize="12sp" />

        <!-- Main clock -->
        <TextView
            android:id="@+id/mainClockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:30"
            android:textColor="#111111"
            android:textSize="62sp"
            android:letterSpacing="-0.055"
            android:layout_marginTop="14dp"
            android:includeFontPadding="false" />

        <!-- Next alarm row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="următoarea în"
                android:textColor="#A8A8A8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/nextAlarmPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8h 42m"
                android:textColor="#8A8A8A"
                android:textSize="10sp"
                android:background="@drawable/bg_small_pill"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EFEFEF"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- Header alarme -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="alarme"
                android:textColor="#B9B9B9"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/addAlarmButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:background="@drawable/bg_add_circle" />

        </LinearLayout>

        <!-- Prima alarmă -->
        <LinearLayout
            android:id="@+id/firstAlarmRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="18dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/firstAlarmTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:30"
                        android:textColor="#111111"
                        android:textSize="31sp"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/firstAlarmAmPm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AM"
                        android:textColor="#BBBBBB"
                        android:textSize="12sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="3dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dayRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="7dp">

                    <TextView
                        android:id="@+id/dayL"
                        style="@style/DayButton"
                        android:text="L" />

                    <TextView
                        android:id="@+id/dayMa"
                        style="@style/DayButton"
                        android:text="M" />

                    <TextView
                        android:id="@+id/dayMi"
                        style="@style/DayButton"
                        android:text="Mi" />

                    <TextView
                        android:id="@+id/dayJ"
                        style="@style/DayButton"
                        android:text="J" />

                    <TextView
                        android:id="@+id/dayV"
                        style="@style/DayButton"
                        android:text="V" />

                    <TextView
                        android:id="@+id/dayS"
                        style="@style/DayButton"
                        android:text="S" />

                    <TextView
                        android:id="@+id/dayD"
                        style="@style/DayButton"
                        android:text="D" />

                </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:id="@+id/firstToggle"
                android:layout_width="42dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_toggle_on">

                <View
                    android:id="@+id/firstToggleDot"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_toggle_dot_white" />

            </FrameLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F1F1" />

        <!-- A doua alarmă disabled -->
        <LinearLayout
            android:id="@+id/secondAlarmRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp"
            android:paddingBottom="15dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="bottom">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:00"
                        android:textColor="#CFCFCF"
                        android:textSize="28sp"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AM"
                        android:textColor="#DDDDDD"
                        android:textSize="11sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="3dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="o singură dată · mâine"
                    android:textColor="#CFCFCF"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_toggle_off">

                <View
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="3dp"
                    android:background="@drawable/bg_toggle_dot_gray" />

            </FrameLayout>

        </LinearLayout>

        <!-- Challenge card -->
        <LinearLayout
            android:id="@+id/challengeCard"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_challenge_black"
            android:paddingStart="18dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="7dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="🏋"
                android:textSize="18sp"
                android:background="@drawable/bg_challenge_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="oprire prin\nflotări"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 secunde ·\ncameră față"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#555555"
                android:textSize="24sp" />

        </LinearLayout>

        <!-- Stats -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <LinearLayout style="@style/StatCard">

                <TextView
                    style="@style/StatNumber"
                    android:text="14" />

                <TextView
                    style="@style/StatLabel"
                    android:text="alarme\noprite" />

            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/StatCard">

                <TextView
                    style="@style/StatNumber"
                    android:text="5\nzile"
                    android:lineSpacingExtra="-4dp" />

                <TextView
                    style="@style/StatLabel"
                    android:text="la\nrând" />

            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout style="@style/StatCard">

                <TextView
                    style="@style/StatNumber"
                    android:text="100%" />

                <TextView
                    style="@style/StatLabel"
                    android:text="săptămâna\nasta" />

            </LinearLayout>

        </LinearLayout>

        <!-- Bottom circle -->
        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="↓"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="@drawable/bg_bottom_circle"
            android:layout_marginTop="-18dp" />

    </LinearLayout>

</ScrollView>