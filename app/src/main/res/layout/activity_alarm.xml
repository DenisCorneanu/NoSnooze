<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="34dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/smallAlarmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ alarma sună"
            android:textColor="#BBBBBB"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/alarmTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:00"
            android:textColor="#111111"
            android:textSize="56sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/instructionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ține poziția de flotare pentru a opri alarma"
            android:textColor="#111111"
            android:textSize="17sp"
            android:lineSpacingExtra="0dp"
            android:layout_marginTop="8dp" />

        <FrameLayout
            android:id="@+id/cameraCard"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_camera_card">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/poseStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="poziție nedetectată"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pose_bad"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/progressCard"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:orientation="vertical"
            android:background="@drawable/bg_progress_card"
            android:padding="18dp"
            android:layout_marginTop="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="timp menținut"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/progressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 /15 sec"
                    android:textColor="#111111"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="15"
                android:progress="0"
                android:layout_marginTop="14dp"
                android:progressDrawable="@drawable/progress_alarm_bar" />

            <TextView
                android:id="@+id/remainingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mai ține poziția încă 15 secunde"
                android:textColor="#999999"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <Button
            android:id="@+id/stopAlarmButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="oprește alarma"
            android:textSize="16sp"
            android:textStyle="bold"
            android:enabled="false"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="snooze dezactivat în timpul provocării"
            android:textColor="#BBBBBB"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>